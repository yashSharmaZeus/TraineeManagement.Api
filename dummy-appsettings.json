{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TraineeManagement.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=YOUR_DB_HOST;port=3306;database=YOUR_DATABASE;user=YOUR_USERNAME;password=YOUR_PASSWORD;",
    "Redis": "YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD"
  },
  "JwtSettings": {
    "Key": "YOUR_64_CHARACTER_OR_LONGER_SECRET_KEY",
    "Issuer": "YOUR_ISSUER",
    "Audience": "YOUR_AUDIENCE",
    "ExpiryMinutes": 60
  },
  "FileStorageSettings": {
    "StorageRoot": "PATH_TO_STORAGE_DIRECTORY"
  },
  "RabbitMQ": {
    "Host": "YOUR_RABBITMQ_HOST",
    "Port": 5672,
    "VirtualHost": "YOUR_VIRTUAL_HOST",
    "Username": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD",
    "QueueName": "YOUR_QUEUE_NAME"
  }
}